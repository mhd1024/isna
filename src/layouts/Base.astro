---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroSrc from '../assets/hero.webp';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const og = await getImage({ src: heroSrc, format: 'jpg', width: 1088 });
const heroPreload = await getImage({ src: heroSrc, format: 'webp', width: 1088 });
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf5ee" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        try { t = localStorage.getItem('isna-theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        // 'motion': elemen yang akan dianimasikan disembunyikan dulu (tanpa kedip).
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        // pengaman: kalau skrip gagal dimuat, tampilkan semua konten
        setTimeout(function () { if (!window.__app) d.classList.remove('motion'); }, 4000);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Caveat: display=block agar judul tidak sempat tampil dengan font cadangan -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&display=block" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />
    <link rel="preload" as="image" href={heroPreload.src} fetchpriority="high" />
  </head>
  <body>
    <slot />
  </body>
</html>
